# ATTENTION: Ce fichier contient des valeurs TEMPLATES
# Créez un fichier secret.yaml en remplaçant les valeurs
# NE COMMITEZ JAMAIS ce fichier avec de vraies valeurs!

apiVersion: v1
kind: Secret
metadata:
  name: setraf-secrets
  namespace: setraf
  labels:
    app: setraf
type: Opaque
stringData:
  # MongoDB Configuration
  mongo-uri: "mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DATABASE?retryWrites=true&w=majority"
  mongo-user: "your_mongo_user"
  mongo-password: "your_mongo_password"
  mongo-cluster: "your_cluster.mongodb.net"
  mongo-db-name: "setraf_db"
  
  # JWT Secrets (générez des clés fortes!)
  jwt-secret: "CHANGE_ME_SUPER_SECRET_JWT_KEY_MIN_32_CHARS"
  jwt-refresh-secret: "CHANGE_ME_SUPER_SECRET_REFRESH_KEY_MIN_32_CHARS"
  
  # Email Configuration (pour OTP)
  email-user: "your_email@example.com"
  email-pass: "your_email_app_password"
  
  # Clés de chiffrement (optionnel)
  public-key: "your_public_key_here"
  private-key: "your_private_key_here"
  
  # API Keys externes (optionnel)
  hf-token: "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"
  tavily-api-key: "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"

---
# Script pour créer le secret depuis .env
# Usage: ./create-k8s-secret.sh
