# =====================================================
# SETRAF - Dockerfile OPTIMISÉ (sans modèles IA)
# Image légère: ~800 MB (au lieu de 20 GB)
# Les modèles IA sont téléchargés automatiquement au premier démarrage
# =====================================================
FROM python:3.10-slim

LABEL maintainer="Belikan M. <nyundumathryme@gmail.com>"
LABEL description="SETRAF - ERT Geophysical Analysis Platform (Optimized)"
LABEL version="2.0.0-optimized"

# Variables d'environnement
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    STREAMLIT_SERVER_PORT=8504 \
    STREAMLIT_SERVER_ADDRESS=0.0.0.0 \
    STREAMLIT_SERVER_HEADLESS=true \
    # Configuration HuggingFace
    HF_HOME=/root/.cache/huggingface \
    TRANSFORMERS_CACHE=/root/.cache/huggingface \
    SENTENCE_TRANSFORMERS_HOME=/root/.cache/huggingface \
    # Configuration TensorFlow/PyTorch
    CUDA_VISIBLE_DEVICES=-1 \
    TF_CPP_MIN_LOG_LEVEL=2

# Installation des dépendances système
# PyGIMLi nécessite cmake, libboost, libeigen3
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Compilateurs
    gcc \
    g++ \
    gfortran \
    cmake \
    # Bibliothèques scientifiques
    libboost-all-dev \
    libeigen3-dev \
    libopenblas-dev \
    liblapack-dev \
    libsuitesparse-dev \
    # Utilitaires
    curl \
    wget \
    git \
    # Nettoyage
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Répertoire de travail
WORKDIR /app

# Copie des requirements et installation des dépendances Python
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt

# Installation de PyGIMLi (si non dans requirements.txt)
RUN pip install --no-cache-dir pygimli || echo "PyGIMLi déjà installé"

# Copie du code source SETRAF (uniquement le code, PAS les modèles)
COPY ERTest.py .
COPY api_setraf.py .
COPY auth_module.py .
COPY logo_belikan.png .
COPY .env .

# Copie du script de démarrage avec téléchargement automatique
COPY startup.sh .
RUN chmod +x startup.sh

# Création des dossiers nécessaires
RUN mkdir -p \
    /app/logs \
    /app/data \
    /app/uploads \
    /app/exports \
    /root/.cache/huggingface

# Exposition des ports
# 8504: ERTest.py (Streamlit standalone)
# 8505: api_setraf.py (FastAPI - optionnel)
EXPOSE 8504 8505

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:8504/_stcore/health || exit 1

# Point d'entrée: script qui télécharge les modèles puis lance l'app
ENTRYPOINT ["/app/startup.sh"]
